menu "Audio Config"

# ------------------------------------------------------------------------------
# Audio Framework (AUDIO_FWK)
# ------------------------------------------------------------------------------
config AUDIO_FWK_MENU
    bool "Enable Audio Framework"
    select AUDIO_FWK if WHC_HOST || WHC_NONE

if AUDIO_FWK_MENU
    choice
        prompt "Select Audio Interfaces"
        config AUDIO_MIXER_MENU
            bool "Mixer"
            select AUDIO_MIXER if WHC_HOST || WHC_NONE
        config AUDIO_PASSTHROUGH_MENU
            bool "PassThrough"
            select AUDIO_PASSTHROUGH if WHC_HOST || WHC_NONE
    endchoice

    if SUPPORT_AUDIO_DEVICE
        menu "Audio Devices"
            comment "Audio Devices"
            config AUDIO_DEVICE_A2DP_MENU
                bool "Bluetooth A2DP Device"
                select AUDIO_DEVICE_A2DP if WHC_HOST || WHC_NONE

            config AUDIO_DEVICE_USB_MENU
                bool "USB Device"
                select AUDIO_DEVICE_USB if WHC_HOST || WHC_NONE
        endmenu
    endif
endif

# ------------------------------------------------------------------------------
# Media Player
# ------------------------------------------------------------------------------
config MEDIA_PLAYER_MENU
    bool "Enable Media Player"
    select AUDIO_FWK_MENU
    select MEDIA_PLAYER if WHC_HOST || WHC_NONE

if MEDIA_PLAYER_MENU
    menu "Media Formats"
        comment "Select supported media formats"

        config MEDIA_FORMAT_WAV_MENU
            bool "WAV"
            select MEDIA_DEMUX_WAV if WHC_HOST || WHC_NONE
            select MEDIA_CODEC_PCM if WHC_HOST || WHC_NONE

        config MEDIA_FORMAT_MP3_MENU
            bool "MP3"
            select MEDIA_DEMUX_MP3 if WHC_HOST || WHC_NONE
            select MEDIA_CODEC_MP3 if WHC_HOST || WHC_NONE

        config MEDIA_FORMAT_AAC_MENU
            bool "AAC"
            select MEDIA_DEMUX_AAC if WHC_HOST || WHC_NONE
            select MEDIA_CODEC_HAAC if WHC_HOST || WHC_NONE
            select THIRD_PARTY_HAAC_MENU

        config MEDIA_FORMAT_M4A_MENU
            bool "M4A"
            select MEDIA_DEMUX_MP4 if WHC_HOST || WHC_NONE
            select MEDIA_CODEC_HAAC if WHC_HOST || WHC_NONE
            select THIRD_PARTY_HAAC_MENU

        config MEDIA_FORMAT_FLAC_MENU
            bool "FLAC"
            select MEDIA_DEMUX_FLAC if WHC_HOST || WHC_NONE
            select THIRD_PARTY_FLAC_MENU

        config MEDIA_FORMAT_AMR_MENU
            bool "AMR"
            select MEDIA_DEMUX_AMR if WHC_HOST || WHC_NONE
            select MEDIA_CODEC_AMR if WHC_HOST || WHC_NONE

        config MEDIA_FORMAT_OGG_MENU
            bool "OGG"
            select MEDIA_DEMUX_OGG if WHC_HOST || WHC_NONE
            if MEDIA_FORMAT_OGG_MENU
                menu "OGG Codec"
                    config MEDIA_OGG_VORBIS_MENU
                        bool "Vorbis"
                        select MEDIA_CODEC_VORBIS if WHC_HOST || WHC_NONE
                        select THIRD_PARTY_TREMOLO_MENU

                    config MEDIA_OGG_OPUS_MENU
                        bool "Opus"
                        select MEDIA_CODEC_OPUS if WHC_HOST || WHC_NONE
                        select THIRD_PARTY_OPUS_MENU
                endmenu
            endif
    endmenu
endif

# ------------------------------------------------------------------------------
# Third Party Libraries
# ------------------------------------------------------------------------------
rsource "third_party/Kconfig"

# ------------------------------------------------------------------------------
# Audio Commands
# ------------------------------------------------------------------------------
rsource "cmds/Kconfig"

endmenu

